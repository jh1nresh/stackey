{
  "name": "stackey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local agent pairing foundation for Stackey",
  "bin": {
    "stackey": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/wallet','dist/src/wallet',{recursive:true})\" && node scripts/build-agent-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "stackey": "node dist/src/cli.js",
    "test:sandbox": "npm run build && node dist/scripts/sandbox-smoke.js"
  },
  "dependencies": {
    "@scure/bip39": "2.2.0",
    "@stripe/link-cli": "0.25.1",
    "ai": "7.0.127",
    "jose": "6.2.12",
    "mppx": "0.13.1",
    "oauth4webapi": "3.8.8",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
